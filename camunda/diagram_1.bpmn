    <bpmn:serviceTask id="Activity_0eukfzj" name="Dispatch Delete Call" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
