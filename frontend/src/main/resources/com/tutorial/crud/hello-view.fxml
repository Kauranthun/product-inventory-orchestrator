<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tutorial.crud.controllers.HelloController">
    <fx:include source="menu.fxml" />
    <Label fx:id="welcomeText" />
    <Button onAction="#onHelloButtonClick" text="Get all hardware" />
    <TableView fx:id="productTable" prefHeight="200.0" prefWidth="200.0">
        <columns>
            <TableColumn fx:id="nameColumn" prefWidth="97.0" text="Hardware name" />
            <TableColumn fx:id="priceColumn" prefWidth="102.0" text="Hardware price" />
            <TableColumn fx:id="idColumn" prefWidth="100.0" text="Hardware ID" />
        </columns>
    </TableView>
</VBox>
