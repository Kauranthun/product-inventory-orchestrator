      </bpmn:extensionElements>
      <bpmn:incoming>Flow_19upeot</bpmn:incoming>
      <bpmn:outgoing>Flow_00ebnxu</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_09ofx77" sourceRef="Gateway_1pnzu8e" targetRef="Activity_0eukfzj">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=actionType = "delete"</bpmn:conditionExpression>
