<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tutorial.crud.controllers.MenuController">

    <MenuBar>
        <menus>
            <Menu mnemonicParsing="false" text="HTTP">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#openGetAllScreen" text="Get All" />
                    <MenuItem mnemonicParsing="false" onAction="#openGetByIdScreen" text="Get by ID" />
                    <MenuItem mnemonicParsing="false" onAction="#openPostScreen" text="POST" />
                </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Edit">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#openUpdateScreen" text="Update" />
                    <MenuItem mnemonicParsing="false" onAction="#delete" text="Delete" />
                </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Database">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#backupDb" text="Backup" />
                    <MenuItem mnemonicParsing="false" onAction="#restoreDb" text="Restore" />
                </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Profile">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#logout" text="Logout" />
                </items>
            </Menu>
        </menus>
    </MenuBar>


</AnchorPane>
