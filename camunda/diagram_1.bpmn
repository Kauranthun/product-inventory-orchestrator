    <bpmn:sequenceFlow id="Flow_1g5b6xg" sourceRef="Gateway_1pnzu8e" targetRef="Activity_0f7si4s">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=actionType = "create"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_0f7si4s" name="Dispatch Create Call" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input source="=userToken" target="authentication.token" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://localhost:8081/camel/product/create" target="url" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="= {&#34;name&#34;: productName, &#34;price&#34;: productPrice}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={&#10;  myResponseBody: response.body&#10;  // Use FEEL to extract values, e.g.,:&#10;  // myUserId: response.body.post.userId&#10;}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1g5b6xg</bpmn:incoming>
      <bpmn:outgoing>Flow_03ef04u</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_19upeot" sourceRef="Gateway_1pnzu8e" targetRef="Activity_0iiju4n">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=actionType = "update"</bpmn:conditionExpression>
